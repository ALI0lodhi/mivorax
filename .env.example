PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/mivorax?replicaSet=mivorax-rs
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
NODE_ENV=development
# Exact frontend origins, separated by commas. No trailing slash.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com
# Use 0.0.0.0 on hosting services, 127.0.0.1 for local development.
HOST=0.0.0.0
# Optional: set to the exact trusted reverse-proxy hop count on your backend host.
# TRUST_PROXY_HOPS=1
# Optional override for npm run db:local if MongoDB Server is not installed in its usual Windows location.
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.3/bin/mongod.exe

# ── Safepay online card payments (optional) ──────────────────────────────────
# Leave these blank to keep online payment switched off (Cash on Delivery still works).
# Fill them in and tick "Online card payments" in Admin → Store settings to go live.
# Get free sandbox keys at https://getsafepay.pk — no documents needed to test.
# SAFEPAY_ENV=sandbox            # sandbox for testing, production for real money
# SAFEPAY_API_KEY=               # "API key" (sec_...) from the Safepay dashboard → Developers
# SAFEPAY_V1_SECRET=             # the signature/shared secret used to verify redirects
# SAFEPAY_WEBHOOK_SECRET=        # the webhook secret used to verify webhook deliveries
# Optional. Public URLs used to build Safepay return links. Default to the request origins.
# PUBLIC_SITE_URL=https://your-domain.com      # the storefront customers see
# PUBLIC_API_URL=https://api.your-domain.com   # this backend's public base URL
