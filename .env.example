PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27018/mivorax?replicaSet=mivorax-rs
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
NODE_ENV=development
# Exact frontend origins, separated by commas. No trailing slash.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-domain.com
# Use 0.0.0.0 on hosting services, 127.0.0.1 for local development.
HOST=0.0.0.0
# Optional: set to the exact trusted reverse-proxy hop count on your backend host.
# TRUST_PROXY_HOPS=1
# Optional override for npm run db:local if MongoDB Server is not installed in its usual Windows location.
# MONGOD_PATH=C:/Program Files/MongoDB/Server/8.3/bin/mongod.exe
