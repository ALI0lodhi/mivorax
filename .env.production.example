PORT=4000
HOST=0.0.0.0
NODE_ENV=production
MONGODB_URI=mongodb+srv://APP_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER/mivorax?retryWrites=true&w=majority
JWT_SECRET=GENERATE_A_NEW_RANDOM_SECRET_OF_AT_LEAST_48_CHARACTERS
CLIENT_ORIGINS=https://your-storefront.example
# Set only after confirming the exact proxy hop count with your backend host.
# TRUST_PROXY_HOPS=1
# ADMIN_EMAIL / ADMIN_PASSWORD are only needed for first-time provisioning, not runtime.
